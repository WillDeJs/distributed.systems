<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Silence noisy ZooKeeper client pings and connection chatter -->
  <logger name="org.apache.zookeeper" level="WARN" />

  <!-- Keep your own custom traces active -->
  <logger name="com.mycompany.cluster.Application" level="TRACE" />

  <!-- Set everything else to WARN or OFF -->
  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
